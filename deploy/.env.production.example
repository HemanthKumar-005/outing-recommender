# =============================================================================
# OUTING RECOMMENDER - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env.production` (or `.env`) on your server and update
# all passwords and domain names before running deployment.
#
# DO NOT commit real secrets or `.env.production` to git.
# =============================================================================

# --- Server / Domain Settings ---
DOMAIN_NAME=yourdomain.com
SERVER_IP=your_server_ip

# --- PostgreSQL (Multi-Tenant Row-Level Security) ---
POSTGRES_DB=outing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_pg_superadmin_password

# Schema Service Roles (must match passwords in postgres/init.sql or your updated init script)
APP_ROLE_USER=app_role
APP_ROLE_PW=app_role_pw

GATEWAY_ROLE_USER=gateway_role
GATEWAY_ROLE_PW=gateway_role_pw

WORKER_ROLE_USER=worker_role
WORKER_ROLE_PW=worker_role_pw

# --- Message Broker (RabbitMQ) ---
RABBITMQ_USER=admin_outing
RABBITMQ_PASS=replace_with_strong_rabbitmq_password

# --- Cache & Key-Value Store (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- API Gateway Settings ---
RATE_LIMIT_PER_MINUTE=120

# --- Frontend Settings (Public Facing) ---
# When deployed behind Nginx, relative path `/api` automatically routes to api-gateway
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_KEY=demo-key

# --- Machine Learning & Evaluation Settings ---
MODEL_PATH=/models/xgboost_model.json
MODEL_METADATA_PATH=/models/xgboost_model.meta.json
RANKING_CONFIG_PATH=/configs/ranking.yaml
EVALUATION_RESULTS_PATH=/evaluation/evaluation_results.csv
N_TRAIN_SAMPLES=25000
TRAIN_SEED=42
