# NEARBY & CO. - PRODUCTION ENVIRONMENT (all free-tier services)
# Copy to deploy/.env.production on the server. NEVER commit the real file.
# Generate every secret with:  openssl rand -base64 36 | tr -d '/+='
# Every variable marked REQUIRED makes `docker compose` refuse to start if empty.
# =============================================================================

# --- Public URL (REQUIRED) ---------------------------------------------------
PUBLIC_BASE_URL=https://your-app.example.com
DOMAIN_NAME=your-app.example.com

# --- Database (all REQUIRED, all different) -----------------------------------
POSTGRES_DB=outing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_ROLE_PW=
GATEWAY_ROLE_PW=
WORKER_ROLE_PW=
TRAINER_ROLE_PW=

# --- Message broker (REQUIRED) ------------------------------------------------
RABBITMQ_USER=outing
RABBITMQ_PASS=

# --- Auth secrets (REQUIRED) --------------------------------------------------
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# --- Cloudflare Turnstile captcha: free, no card (REQUIRED in production) -----
# https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email via any free SMTP relay: Brevo / Resend / Gmail app password -------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nearby & Co. <no-reply@your-app.example.com>"
REQUIRE_EMAIL_VERIFICATION=true

# --- Optional -------------------------------------------------------------------
# Error tracking: free Sentry Developer plan or self-hosted GlitchTip DSN
SENTRY_DSN=
# Weather: Open-Meteo needs no key (non-commercial only). OpenWeatherMap key is optional.
OPENWEATHERMAP_API_KEY=
OPEN_METEO_ENABLED=true
# Routing: public OSRM demo works without a key; LocationIQ free key is optional.
LOCATIONIQ_API_KEY=
# Map tiles. Empty = public OpenStreetMap tiles (low-traffic beta only, see docs/FREE_STACK.md).
NEXT_PUBLIC_TILE_URL=
# Launch gate: only show venues a human has verified (keep true for public launch)
VERIFIED_ONLY=true
RATE_LIMIT_PER_MINUTE=120
MAX_TENANTS=100

