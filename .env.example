# LOCAL DEVELOPMENT ONLY. Copy to .env (git-ignored). `make dev-env` fills these in for you.
# No value here is a real secret; everything below is random/dev-only.
POSTGRES_PASSWORD=change-me-dev
APP_ROLE_PW=change-me-dev-app
GATEWAY_ROLE_PW=change-me-dev-gateway
WORKER_ROLE_PW=change-me-dev-worker
TRAINER_ROLE_PW=change-me-dev-trainer
RABBITMQ_USER=outing
RABBITMQ_PASS=change-me-dev-rabbit
JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
INTERNAL_SERVICE_TOKEN=dev-only-internal-token-change-me

# Cloudflare publishes always-pass Turnstile TEST keys for development:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional (free; leave empty to skip):
LOCATIONIQ_API_KEY=
OPENWEATHERMAP_API_KEY=
SENTRY_DSN=
