# Copy to .env and adjust before `docker compose up` if you need to override
# defaults baked into docker-compose.yml. Most values below already have
# working defaults for local development.

# --- Postgres (multi-tenant, row-level security - see postgres/init.sql) ---
POSTGRES_DB=outing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_pw
# app_role: CRUD on tenant-owned schemas, RLS-scoped per request
DATABASE_URL=postgresql://app_role:app_role_pw@postgres:5432/outing
# gateway_role: SELECT+INSERT on platform.tenants only (API key resolution + signup)
# worker_role: SELECT on platform.tenants only (background tenant-sweep loops)
PLATFORM_DATABASE_URL=postgresql://gateway_role:gateway_role_pw@postgres:5432/outing

# --- API gateway ---
RATE_LIMIT_PER_MINUTE=120

# --- Event bus / cache ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
REDIS_URL=redis://redis:6379/0

# --- Recommendation engine / model training ---
MODEL_PATH=/models/xgboost_model.json
MODEL_METADATA_PATH=/models/xgboost_model.meta.json
RANKING_CONFIG_PATH=/configs/ranking.yaml
EVALUATION_RESULTS_PATH=/evaluation/evaluation_results.csv
N_TRAIN_SAMPLES=20000
TRAIN_SEED=42

# --- Frontend (baked in at build time, see frontend/Dockerfile ARGs) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_KEY=demo-key
